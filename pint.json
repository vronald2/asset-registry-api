{
    "preset": "psr12",
    "rules": {
        "declare_strict_types": true,
        "array_syntax": {
            "syntax": "short"
        },
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha",
            "imports_order": [
                "class",
                "function",
                "const"
            ]
        },
        "single_quote": true,
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays",
                "arguments",
                "parameters",
                "match"
            ]
        },
        "concat_space": {
            "spacing": "one"
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage"
    ]
}
